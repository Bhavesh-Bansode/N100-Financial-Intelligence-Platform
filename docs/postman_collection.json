{
  "info": {
    "name": "Nifty 100 Financial Intelligence API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Get Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Get Companies",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies"
      }
    },
    {
      "name": "Get Company",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}"
      }
    },
    {
      "name": "Get Profit And Loss",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/pl"
      }
    },
    {
      "name": "Get Balance Sheet",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/bs"
      }
    },
    {
      "name": "Get Cashflow",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/cashflow"
      }
    },
    {
      "name": "Get Ratios",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/ratios"
      }
    },
    {
      "name": "Download Tearsheet",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/tearsheet"
      }
    },
    {
      "name": "Compare With Peers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/peers/compare"
      }
    },
    {
      "name": "Get Documents",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/companies/{{ticker}}/documents"
      }
    },
    {
      "name": "Get Screener",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/screener"
      }
    },
    {
      "name": "Get Sectors",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/sectors"
      }
    },
    {
      "name": "Get Sector Companies",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/sectors/{{sector}}/companies"
      }
    },
    {
      "name": "Get Peer Group",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/peers/{{group_name}}"
      }
    },
    {
      "name": "Get Valuation Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/valuation/"
      }
    },
    {
      "name": "Get Portfolio Stats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/portfolio/stats"
      }
    },
    {
      "name": "Get Documents Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/documents/"
      }
    },
    {
      "name": "Get Market Cap History",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/market-cap/{{ticker}}"
      }
    }
  ]
}